  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KC3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumCContradiction"/>
    <rdfs:label xml:lang="en">Dependence Violation</rdfs:label>
    <skos:notation>K-C3</skos:notation>
    <obo:IAO_0000115 xml:lang="en">A dependent entity posited without its bearer, or a grounding link severed, including where one direction of a mutual dependence is enforced and the other denied.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Husserl on foundation, as developed by Smith; BFO specific dependence</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: A specifically dependent continuant without a bearer</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Requires a dependent entity and a bearer relation. Presenting facts are the bearer side, not the dependent side.</rk:wellFormednessRationale>
    <rk:detectionInstrument>reasoner_partial</rk:detectionInstrument>
    <rk:operationalized>False</rk:operationalized>
  </rdf:Description>
