  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b163">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
    <owl:someValuesFrom rdf:resource="https://sool.davidkoepsell.com/ontology/rk#Classification"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b201">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
    <owl:someValuesFrom rdf:resource="https://sool.davidkoepsell.com/ontology/rk#Specification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KA1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumAContradiction"/>
    <rdfs:label xml:lang="en">Inconsistency</rdfs:label>
    <skos:notation>K-A1</skos:notation>
    <obo:IAO_0000115 xml:lang="en">The theory admits no model; locally, a sentence and its negation are both derivable. Variants: assertional, deontic, analytic.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Aristotle on non-contradiction; Schlobach and Cornet (2003); Hohfeld (1917) for the analytic variant</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: O |= ⊥ globally; locally, jointly unsatisfiable assertions over one locus</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Jointly unsatisfiable assertions can be made about any locus, including presenting facts.</rk:wellFormednessRationale>
    <rk:detectionInstrument>reasoner</rk:detectionInstrument>
    <rk:operationalized>False</rk:operationalized>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#detectionInstrument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">detection instrument</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b47">
    <rdf:first rdf:nodeID="nee5ebead03d44b489e39592455ee0655b45"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b103">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
    <owl:someValuesFrom rdf:resource="https://sool.davidkoepsell.com/ontology/rk#AssessorSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b81">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nee5ebead03d44b489e39592455ee0655b83"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Nothing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#conferredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">conferred by</rdfs:label>
    <rdfs:domain rdf:resource="https://sool.davidkoepsell.com/ontology/rk#ConferredStatusRole"/>
    <rdfs:range rdf:resource="https://sool.davidkoepsell.com/ontology/rk#RecognitionAct"/>
    <rdfs:comment xml:lang="en">Relates a role to the process in which it came to be borne.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#ActSpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#Specification"/>
    <rdfs:label xml:lang="en">Recognition act</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">The act in which criteria are applied to facts and a status is conferred.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#EffectsSpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#Specification"/>
    <rdfs:label xml:lang="en">Effects</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">The consequences following from the conferral.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KA2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumAContradiction"/>
    <rdfs:label xml:lang="en">Term Incoherence</rdfs:label>
    <skos:notation>K-A2</skos:notation>
    <obo:IAO_0000115 xml:lang="en">The theory is satisfiable but some term is not: a class equivalent to the empty class.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Schlobach and Cornet (2003)</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: O consistent, yet O |= C ⊑ ⊥</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Requires a defined term whose satisfaction conditions can empty out. Presenting facts are asserted, not defined.</rk:wellFormednessRationale>
    <rk:detectionInstrument>reasoner</rk:detectionInstrument>
    <rk:operationalized>False</rk:operationalized>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#DeclarationWithoutBorneRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">declaration without borne role</rdfs:label>
    <owl:equivalentClass rdf:nodeID="nee5ebead03d44b489e39592455ee0655b10"/>
    <obo:IAO_0000115 xml:lang="en">A status declaration that is about no borne role. This class exists to make a position statable, not to be inferred: nothing will classify here without a closure axiom.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b108">
    <rdf:first rdf:resource="https://sool.davidkoepsell.com/ontology/rk#KD2"/>
