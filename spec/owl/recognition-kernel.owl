  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#ConferredStatusRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    <rdfs:subClassOf rdf:nodeID="nee5ebead03d44b489e39592455ee0655b9"/>
    <rdfs:label xml:lang="en">conferred status role</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A role borne by an entity in virtue of a recognition act. Every such role is characteristic of some independent continuant: that is what having a bearer amounts to, and it is precisely what a status declaration does not assert.</obo:IAO_0000115>
  </rdf:Description>
