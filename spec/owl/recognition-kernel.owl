  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KB2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumBContradiction"/>
    <rdfs:label xml:lang="en">Equivocation</rdfs:label>
    <skos:notation>K-B2</skos:notation>
    <obo:IAO_0000115 xml:lang="en">One item playing incompatible roles: a term, condition, or occupant doing double duty under conflicting demands.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Aristotle on equivocation</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: One element bound to two roles with conflicting satisfaction conditions</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Double duty is available at every locus, including facts, where one described state of affairs can be bound to two incompatible characterizations.</rk:wellFormednessRationale>
    <rk:detectionInstrument>structural</rk:detectionInstrument>
    <rk:operationalized>False</rk:operationalized>
  </rdf:Description>
