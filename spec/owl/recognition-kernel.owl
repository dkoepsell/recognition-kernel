  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#RepairFailure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#Contradiction"/>
    <rdfs:label xml:lang="en">Repair Failure</rdfs:label>
    <skos:notation>RF</skos:notation>
    <obo:IAO_0000115 xml:lang="en">K-D3 located at the remedy locus in a legal order.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Structural Ontology of Law (Koepsell forthcoming), located at these coordinates in §7.2 Table 7.</obo:IAO_0000119>
    <owl:equivalentClass rdf:nodeID="nee5ebead03d44b489e39592455ee0655b155"/>
  </rdf:Description>
