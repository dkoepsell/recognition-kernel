  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KD2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumDContradiction"/>
    <rdfs:label xml:lang="en">Performative Self-Defeat</rdfs:label>
    <skos:notation>K-D2</skos:notation>
    <obo:IAO_0000115 xml:lang="en">An act whose success conditions are undermined by its own performance: a norm whose compliance conditions preclude compliance.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Hintikka on the performative cogito; Apel and Habermas on performative contradiction</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: Satisfying the act's content entails failure of its success conditions</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Requires an act with success conditions, or a norm stating compliance conditions.</rk:wellFormednessRationale>
    <rk:detectionInstrument>process_or_text_internal</rk:detectionInstrument>
    <rk:operationalized>partial</rk:operationalized>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#ThresholdPolytheticIncoherence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#Contradiction"/>
    <rdfs:label xml:lang="en">Threshold / Polythetic Incoherence</rdfs:label>
    <skos:notation>CT-3</skos:notation>
    <obo:IAO_0000115 xml:lang="en">K-A3 located at the criteria locus in a classification.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Paper §7.3 Table 8.</obo:IAO_0000119>
    <owl:equivalentClass rdf:nodeID="nee5ebead03d44b489e39592455ee0655b173"/>
  </rdf:Description>
