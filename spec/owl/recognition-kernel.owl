  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#StratumDContradiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#Contradiction"/>
    <rdfs:label xml:lang="en">Pragmatic</rdfs:label>
    <skos:note xml:lang="en">precondition: acts; gated: true</skos:note>
    <obo:IAO_0000115 xml:lang="en">Failures available only where there are acts.</obo:IAO_0000115>
  </rdf:Description>
