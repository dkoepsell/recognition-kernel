  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KD3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumDContradiction"/>
    <rdfs:label xml:lang="en">Modal Clash</rdfs:label>
    <skos:notation>K-D3</skos:notation>
    <obo:IAO_0000115 xml:lang="en">A capacity present in structure but blocked in practice: possible according to the artifact, unrealizable in the institution implementing it. (de jure / de facto)</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Pound (1910) on law in books versus law in action</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: ◇-in-structure with ¬◇-in-practice for the same capacity</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Requires a capacity. Presenting facts confer none.</rk:wellFormednessRationale>
    <rk:detectionInstrument>process_or_text_internal</rk:detectionInstrument>
    <rk:operationalized>True</rk:operationalized>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b174">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
