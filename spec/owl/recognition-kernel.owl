    <obo:IAO_0000115 xml:lang="en">Failures in how terms are defined and grounded, independent of domain content.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#AuthoritySpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
