  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#RemedySpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#Specification"/>
    <rdfs:label xml:lang="en">Remedy</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">The pathway, where the system provides one, by which a conferral can be revisited.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#StratumCContradiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#Contradiction"/>
    <rdfs:label xml:lang="en">Meta-ontological</rdfs:label>
    <skos:note xml:lang="en">precondition: an upper ontology; gated: false</skos:note>
    <obo:IAO_0000115 xml:lang="en">Failures of typing and grounding relative to an upper ontology.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#ActEmptyArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">act-empty artifact</rdfs:label>
    <owl:equivalentClass rdf:nodeID="nee5ebead03d44b489e39592455ee0655b4"/>
    <obo:IAO_0000115 xml:lang="en">A recognition artifact with no act specification part. Typing an individual here is a closure assertion: OWL will not conclude the absence of a part on its own.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#StatusDeclaration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
    <rdfs:label xml:lang="en">status declaration</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An information content entity that is about a conferred status role.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#Specification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
    <rdfs:label xml:lang="en">chain specification</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A directive information entity that is part of a recognition artifact and supplies one link of its chain.</obo:IAO_0000115>
  </rdf:Description>
