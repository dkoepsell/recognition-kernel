  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KB3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumBContradiction"/>
    <rdfs:label xml:lang="en">Residual Definition</rdfs:label>
    <skos:notation>K-B3</skos:notation>
    <obo:IAO_0000115 xml:lang="en">A term defined only by complement: membership fixed negatively, as what remains once the positive categories are exhausted.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Koepsell, D. R., The Recognition Layer: A Generative Typology of Structural Contradiction for Recognition-Constituted Domains (working draft), §6-§8.</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: C ≡ ¬D₁ ⊓ ¬D₂ ⊓ … with no positive differentia</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Well-formed wherever a positive differentia is owed. An authority is designated rather than defined by complement; facts are asserted; the act is performed.</rk:wellFormednessRationale>
    <rk:detectionInstrument>structural</rk:detectionInstrument>
    <rk:operationalized>False</rk:operationalized>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b61">
