  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KC1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumCContradiction"/>
    <rdfs:label xml:lang="en">Category Violation</rdfs:label>
    <skos:notation>K-C1</skos:notation>
    <obo:IAO_0000115 xml:lang="en">An entity forced under disjoint upper-ontological categories: the formalized category mistake.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Ryle (1949); BFO disjointness axioms (Arp, Smith, and Spear 2015)</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: a : C and a : D, C and D disjoint at the upper level</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Anything typed at all can be mistyped.</rk:wellFormednessRationale>
    <rk:detectionInstrument>reasoner</rk:detectionInstrument>
    <rk:operationalized>False</rk:operationalized>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KA3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumAContradiction"/>
    <rdfs:label xml:lang="en">Indeterminacy</rdfs:label>
    <skos:notation>K-A3</skos:notation>
    <obo:IAO_0000115 xml:lang="en">Underconstraint: unintended models admitted, or membership undecided where practice requires a decision.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Waismann (1945); Hart (1961) on open texture</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: Intended and admitted models diverge; borderline membership underivable</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Underconstraint is available wherever anything is specified at all.</rk:wellFormednessRationale>
    <rk:detectionInstrument>structural</rk:detectionInstrument>
    <rk:operationalized>False</rk:operationalized>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b65">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
    <owl:someValuesFrom rdf:resource="https://sool.davidkoepsell.com/ontology/rk#FactsSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KB1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumBContradiction"/>
    <rdfs:label xml:lang="en">Circularity</rdfs:label>
    <skos:notation>K-B1</skos:notation>
    <obo:IAO_0000115 xml:lang="en">Non-wellfounded definition or grounding: a term's conditions depend transitively on the term itself, or a grounding order is inverted. The temporal case is inversion projected into time.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">Koepsell, D. R., The Recognition Layer: A Generative Typology of Structural Contradiction for Recognition-Constituted Domains (working draft), §6-§8.</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: A cycle in the definition dependency graph, or inversion of a required grounding order</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Requires a definition or grounding order. Presenting facts supply neither.</rk:wellFormednessRationale>
    <rk:detectionInstrument>reasoner_partial</rk:detectionInstrument>
    <rk:operationalized>False</rk:operationalized>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b57">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
    <owl:someValuesFrom rdf:resource="https://sool.davidkoepsell.com/ontology/rk#FactsSpecification"/>
