    <rdfs:label xml:lang="en">Criteria</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">The substantive standard applied in the recognition act.</obo:IAO_0000115>
  </rdf:Description>
  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#AuthorityInflation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#Contradiction"/>
