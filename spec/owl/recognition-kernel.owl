  <rdf:Description rdf:about="https://sool.davidkoepsell.com/ontology/rk#KD1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://sool.davidkoepsell.com/ontology/rk#StratumDContradiction"/>
    <rdfs:label xml:lang="en">Falsification</rdfs:label>
    <skos:notation>K-D1</skos:notation>
    <obo:IAO_0000115 xml:lang="en">Assertion and world mismatched: triggering conditions fabricated, suppressed, or misrepresented. The artifact is coherent; its contact with reality is corrupted.</obo:IAO_0000115>
    <obo:IAO_0000119 xml:lang="en">the law of evidence as an institutionalized detection apparatus</obo:IAO_0000119>
    <skos:note xml:lang="en">formal signature: An asserted triggering condition with no worldly truthmaker</skos:note>
    <rk:wellFormednessRationale xml:lang="en">Requires something asserted about the world. Authority, criteria and role are conferred rather than asserted.</rk:wellFormednessRationale>
    <rk:detectionInstrument>world_facing</rk:detectionInstrument>
    <rk:operationalized>False</rk:operationalized>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nee5ebead03d44b489e39592455ee0655b202">
